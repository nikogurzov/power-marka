#!/bin/sh
# power-marka lid helper — runs as root via pkexec.
# Usage: lid-helper set <battery> <ac> <docked> | lid-helper reset
set -eu
CONF=/etc/systemd/logind.conf.d/50-power-marka.conf
OLD=/etc/systemd/logind.conf.d/50-power-plus.conf   # from when the app was called Power Plus
ok() { case "$1" in suspend|lock|ignore|poweroff|hibernate) return 0;; *) return 1;; esac; }
case "${1:-}" in
  set)
    [ $# -eq 4 ] || exit 2
    ok "$2" && ok "$3" && ok "$4" || exit 2
    mkdir -p /etc/systemd/logind.conf.d
    printf '# Written by power-marka (formerly Power Plus). Remove this file to restore defaults.\n[Login]\nHandleLidSwitch=%s\nHandleLidSwitchExternalPower=%s\nHandleLidSwitchDocked=%s\n' "$2" "$3" "$4" > "$CONF.tmp"
    chmod 644 "$CONF.tmp"; mv "$CONF.tmp" "$CONF"; rm -f "$OLD" ;;
  reset) rm -f "$CONF" "$OLD" ;;
  *) exit 2 ;;
esac
# reload logind config without ending sessions
systemctl kill -s HUP systemd-logind
