<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Palamarka (power-marka)</vendor>
  <vendor_url>https://tech.palamarka.com</vendor_url>
  <action id="com.palamarka.PowerMarka.lid">
    <description>Change what happens when the laptop lid is closed</description>
    <description xml:lang="bg">Промяна на действието при затваряне на капака</description>
    <message>Authentication is required to change the lid close action</message>
    <message xml:lang="bg">Нужна е парола, за да се смени действието при затваряне на капака</message>
    <icon_name>com.palamarka.PowerMarka</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/power-marka/lid-helper</annotate>
  </action>
</policyconfig>
